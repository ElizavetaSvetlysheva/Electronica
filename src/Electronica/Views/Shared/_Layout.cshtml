@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Магазин электроники</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-controller="Products" asp-action="Index">
                <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1.5"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg></span>
                <span>Магазин <b>электроники</b></span>
            </a>
            <nav class="nav">
                <a asp-controller="Products" asp-action="Index" class="@(action == "Index" ? "active" : "")">Товары</a>
                <a asp-controller="Products" asp-action="Import" class="@(action == "Import" ? "active" : "")">Импорт CSV</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

</body>
</html>
